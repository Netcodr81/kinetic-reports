@namespace KineticReports.Viewer.Blazor
@using KineticReports.Core.Definition
@using KineticReports.Core.Layout
@using KineticReports.Core.Viewer.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IReportService ReportService
@inject IJSRuntime Js
@using System.Text
@using System.Text.RegularExpressions

<div class="@ViewerCssClass" style="@ComputedViewerStyle">
    <div class="kinetic-report-card">
        <div class="kinetic-report-card-header" role="toolbar" aria-label="Report actions">
            <div class="kinetic-report-toolbar-group">
                <button type="button" class="kinetic-report-header-button" @onclick="PrintAsync"
                        disabled="@string.IsNullOrEmpty(HtmlContent)" title="Print report" aria-label="Print report">
                    <i class="fa-solid fa-print"></i>
                </button>
            </div>

            <div class="kinetic-report-viewer-pager" aria-label="Report page navigation">
                <button type="button" class="kinetic-report-header-button" @onclick="GoToFirstPage"
                        disabled="@(!CanNavigateBackward)" title="First page" aria-label="First page">
                    <i class="fa-solid fa-backward-fast"></i>
                </button>
                <button type="button" class="kinetic-report-header-button" @onclick="GoToPreviousPage"
                        disabled="@(!CanNavigateBackward)" title="Previous page" aria-label="Previous page">
                    <i class="fa-solid fa-backward-step"></i>
                </button>
                <span>Page @(HasReportPages ? _currentPageNumber : 0) of @TotalPages</span>
                <button type="button" class="kinetic-report-header-button" @onclick="GoToNextPage"
                        disabled="@(!CanNavigateForward)" title="Next page" aria-label="Next page">
                    <i class="fa-solid fa-forward-step"></i>
                </button>
                <button type="button" class="kinetic-report-header-button" @onclick="GoToLastPage"
                        disabled="@(!CanNavigateForward)" title="Last page" aria-label="Last page">
                    <i class="fa-solid fa-forward-fast"></i>
                </button>
            </div>

            <div class="kinetic-report-toolbar-group">
                <button type="button" class="kinetic-report-header-button" @onclick="PrintPdf"
                        disabled="@(ReportDocument is null)" title="Download PDF" aria-label="Download PDF">
                    <i class="fa-solid fa-file-pdf"></i>
                </button>
                <button type="button" class="kinetic-report-header-button" @onclick="PrintHtml"
                        disabled="@(ReportDocument is null)" title="Download HTML" aria-label="Download HTML">
                    <i class="fa-brands fa-html5"></i>
                </button>
                @if (ToolbarActions is not null)
                {
                    @ToolbarActions
                }
            </div>
        </div>

        <div class="kinetic-report-card-body">

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @ErrorMessage
                    <button type="button" class="btn-close" @onclick="(() => ErrorMessage = string.Empty)"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(HtmlContent))
            {
                <div class="report-output">
                    <div id="@_previewContainerId" class="preview-content">@((MarkupString)GetInlinePreviewMarkup())</div>
                </div>
            }
            else if (!IsLoading)
            {
                <div class="alert alert-info">
                    Provide a report document to render preview output.
                </div>
            }
        </div>
    </div>
</div>


@code {

    /// <summary>
    /// The prebuilt report document to render as HTML.
    /// </summary>
    [Parameter]
    public ReportDocument? ReportDocument { get; set; }

    /// <summary>
    /// Optional report definition used for plugin toggles and metadata-driven export behavior.
    /// </summary>
    [Parameter]
    public ReportDefinition? ReportDefinition { get; set; }

    /// <summary>
    /// Whether to render automatically when the report document changes.
    /// </summary>
    [Parameter]
    public bool AutoRender { get; set; } = true;

    /// <summary>
    /// Callback invoked when rendering completes.
    /// </summary>
    [Parameter]
    public EventCallback<ReportExecutionResult> OnExecutionComplete { get; set; }

    /// <summary>
    /// Selects the built-in viewer density profile.
    /// </summary>
    [Parameter]
    public ReportViewerDensity Density { get; set; } = ReportViewerDensity.Comfortable;

    /// <summary>
    /// Optional accent color token (e.g. #2563eb) applied via CSS variable.
    /// </summary>
    [Parameter]
    public string? AccentColor { get; set; }

    /// <summary>
    /// Optional surface background token applied via CSS variable.
    /// </summary>
    [Parameter]
    public string? SurfaceColor { get; set; }

    /// <summary>
    /// Optional border color token applied via CSS variable.
    /// </summary>
    [Parameter]
    public string? BorderColor { get; set; }

    /// <summary>
    /// Optional page background token applied via CSS variable.
    /// </summary>
    [Parameter]
    public string? PageBackgroundColor { get; set; }

    /// <summary>
    /// Optional additional toolbar content appended to the right toolbar group.
    /// </summary>
    [Parameter]
    public RenderFragment? ToolbarActions { get; set; }

    /// <summary>
    /// Selects the built-in color theme for the viewer.
    /// </summary>
    [Parameter]
    public ReportViewerTheme Theme { get; set; } = ReportViewerTheme.Light;

    private string HtmlContent { get; set; } = string.Empty;
    private string ErrorMessage { get; set; } = string.Empty;
    private bool IsLoading { get; set; }
    private readonly string _previewContainerId = $"kr-viewer-preview-{Guid.NewGuid():N}";
    private CancellationTokenSource? _renderCts;
    private ReportDocument? _lastRenderedReportDocument;
    private ReportDefinition? _lastRenderedReportDefinition;
    private int _currentPageNumber = 1;

    private int TotalPages => ReportDocument?.PageCount ?? 0;

    private bool HasReportPages => TotalPages > 0;

    private bool CanNavigateBackward => HasReportPages && _currentPageNumber > 1;

    private bool CanNavigateForward => HasReportPages && _currentPageNumber < TotalPages;

    private IJSObjectReference? _jsModule;

    private string ViewerCssClass => $"kinetic-report-viewer kinetic-report-viewer--{GetDensityClass(Density)} kinetic-report-viewer--{GetThemeClass(Theme)}";

    private string ComputedViewerStyle => BuildViewerStyle();

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (AutoRender
            && ReportDocument is not null
            && (!ReferenceEquals(_lastRenderedReportDocument, ReportDocument)
                || !ReferenceEquals(_lastRenderedReportDefinition, ReportDefinition)))
        {
            await RenderReportDocumentAsync();
            _lastRenderedReportDocument = ReportDocument;
            _lastRenderedReportDefinition = ReportDefinition;
        }
    }

    /// <summary>
    /// Renders the current report document and displays the HTML output.
    /// </summary>
    private async Task RenderReportDocumentAsync()
    {
        if (ReportDocument is null)
        {
            ErrorMessage = "A report document is required.";
            return;
        }

        IsLoading = true;
        ErrorMessage = string.Empty;
        HtmlContent = string.Empty;

        _renderCts?.Cancel();
        _renderCts?.Dispose();
        _renderCts = new CancellationTokenSource();

        try
        {
            HtmlContent = await ReportService.RenderHtmlAsync(
                ReportDocument,
                ReportDefinition,
                _renderCts.Token);

            if (string.IsNullOrEmpty(HtmlContent))
            {
                ErrorMessage = "Report render failed: HTML content is empty.";
                return;
            }

            _currentPageNumber = 1;

            await OnExecutionComplete.InvokeAsync(new ReportExecutionResult
            {
                Success = true,
                ExecutedAt = DateTime.UtcNow,
                HtmlContent = HtmlContent
            });
        }
        catch (OperationCanceledException)
        {
            ErrorMessage = "Report rendering was cancelled.";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Report rendering failed: {ex.Message}";
            await OnExecutionComplete.InvokeAsync(new ReportExecutionResult
            {
                Success = false,
                ErrorMessage = ex.Message,
                ExecutedAt = DateTime.UtcNow
            });
        }
        finally
        {
            IsLoading = false;
        }
    }

    private string GetInlinePreviewMarkup()
    {
        if (string.IsNullOrEmpty(HtmlContent))
            return string.Empty;

        var styleBuilder = new StringBuilder();
        var styleRegex = new Regex("<style\\b[^>]*>[\\s\\S]*?</style>", RegexOptions.IgnoreCase |
                                                                        RegexOptions.CultureInvariant);
        foreach (Match match in styleRegex.Matches(HtmlContent))
        {
            styleBuilder.Append(match.Value);
        }

        if (HasReportPages)
        {
            styleBuilder.Append($"<style>#report-document > .kinetic-page {{ display: none !important; }} #report-document > .kinetic-page:nth-of-type({_currentPageNumber}) {{ display: block !important; }}</style>");
        }

        var bodyStart = HtmlContent.IndexOf("<body", StringComparison.OrdinalIgnoreCase);
        if (bodyStart < 0)
            return styleBuilder + HtmlContent;

        var bodyOpenEnd = HtmlContent.IndexOf('>', bodyStart);
        if (bodyOpenEnd < 0)
            return styleBuilder + HtmlContent;

        var bodyCloseStart = HtmlContent.IndexOf("</body>", bodyOpenEnd, StringComparison.OrdinalIgnoreCase);
        if (bodyCloseStart < 0)
            bodyCloseStart = HtmlContent.Length;

        var bodyMarkup = HtmlContent.Substring(bodyOpenEnd + 1, bodyCloseStart - bodyOpenEnd - 1);
        return styleBuilder + bodyMarkup;
    }

    private string GetPrintMarkup()
    {
        if (string.IsNullOrEmpty(HtmlContent))
            return string.Empty;

        var styleBuilder = new StringBuilder();
        var styleRegex = new Regex("<style\\b[^>]*>[\\s\\S]*?</style>", RegexOptions.IgnoreCase |
                                                                        RegexOptions.CultureInvariant);
        foreach (Match match in styleRegex.Matches(HtmlContent))
        {
            styleBuilder.Append(match.Value);
        }

        styleBuilder.Append("<style>#report-document > .kinetic-page { display: block !important; }</style>");

        var bodyStart = HtmlContent.IndexOf("<body", StringComparison.OrdinalIgnoreCase);
        if (bodyStart < 0)
            return $"<!doctype html><html class=\"kinetic-report\"><head><meta charset=\"utf-8\">{styleBuilder}</head><body>{HtmlContent}</body></html>";

        var bodyOpenEnd = HtmlContent.IndexOf('>', bodyStart);
        if (bodyOpenEnd < 0)
            return $"<!doctype html><html class=\"kinetic-report\"><head><meta charset=\"utf-8\">{styleBuilder}</head><body>{HtmlContent}</body></html>";

        var bodyCloseStart = HtmlContent.IndexOf("</body>", bodyOpenEnd, StringComparison.OrdinalIgnoreCase);
        if (bodyCloseStart < 0)
            bodyCloseStart = HtmlContent.Length;

        var bodyMarkup = HtmlContent.Substring(bodyOpenEnd + 1, bodyCloseStart - bodyOpenEnd - 1);
        return $"<!doctype html><html class=\"kinetic-report\"><head><meta charset=\"utf-8\">{styleBuilder}</head><body>{bodyMarkup}</body></html>";
    }

    private async Task PrintAsync()
    {
        if (string.IsNullOrEmpty(HtmlContent))
            return;

        var jsModule = await EnsureJsModuleAsync();
        await jsModule.InvokeVoidAsync("printReportMarkup", GetPrintMarkup());
    }

    private async Task PrintPdf()
    {
        await DownloadCurrentReportAsync("pdf");
    }

    private async Task PrintHtml()
    {
        await DownloadCurrentReportAsync("html");
    }

    private async Task DownloadCurrentReportAsync(string formatId)
    {
        if (ReportDocument is null)
        {
            ErrorMessage = "A report document is required.";
            return;
        }

        try
        {
            ErrorMessage = string.Empty;
            var exportResult = await ReportService.ExportAsync(ReportDocument, ReportDefinition, formatId);
            var base64Content = Convert.ToBase64String(exportResult.Content);

            var fileNameStem = SanitizeFileNameStem(ReportDocument.Metadata.FileName)
                ?? SanitizeFileNameStem(ReportDocument.Metadata.ReportName)
                ?? $"report-{DateTime.UtcNow:yyyyMMdd-HHmmss}";
            var fileName = $"{fileNameStem}.{exportResult.FileExtension}";

            var jsModule = await EnsureJsModuleAsync();
            await jsModule.InvokeVoidAsync("downloadFromBase64", fileName, exportResult.MimeType, base64Content);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Report export failed: {ex.Message}";
        }
    }

    private static string? SanitizeFileNameStem(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        var trimmed = value.Trim();
        foreach (var invalidChar in System.IO.Path.GetInvalidFileNameChars())
        {
            trimmed = trimmed.Replace(invalidChar, '-');
        }

        return string.IsNullOrWhiteSpace(trimmed) ? null : trimmed;
    }

    private static string GetDensityClass(ReportViewerDensity density)
    {
        return density switch
        {
            ReportViewerDensity.Compact => "compact",
            ReportViewerDensity.Spacious => "spacious",
            _ => "comfortable"
        };
    }

    private static string GetThemeClass(ReportViewerTheme theme)
    {
        return theme switch
        {
            ReportViewerTheme.Dark => "dark",
            _ => "light"
        };
    }

    private string BuildViewerStyle()
    {
        var styleParts = new List<string>();

        AppendCssVariable(styleParts, "--kr-accent", AccentColor);
        AppendCssVariable(styleParts, "--kr-surface", SurfaceColor);
        AppendCssVariable(styleParts, "--kr-border", BorderColor);
        AppendCssVariable(styleParts, "--kr-page-bg", PageBackgroundColor);

        return string.Join(' ', styleParts);
    }

    private static void AppendCssVariable(List<string> styleParts, string variableName, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return;

        styleParts.Add($"{variableName}: {value.Trim()};");
    }

    private async Task<IJSObjectReference> EnsureJsModuleAsync()
    {
        _jsModule ??= await Js.InvokeAsync<IJSObjectReference>(
            "import",
            "./_content/KineticReports.Viewer.Blazor/reportViewer.js");

        return _jsModule;
    }

    private void GoToFirstPage()
    {
        if (!HasReportPages)
            return;

        _currentPageNumber = 1;
        StateHasChanged();
    }

    private void GoToPreviousPage()
    {
        if (!CanNavigateBackward)
            return;

        _currentPageNumber--;
        StateHasChanged();
    }

    private void GoToNextPage()
    {
        if (!CanNavigateForward)
            return;

        _currentPageNumber++;
        StateHasChanged();
    }

    private void GoToLastPage()
    {
        if (!HasReportPages)
            return;

        _currentPageNumber = TotalPages;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await EnsureJsModuleAsync();
        }
    }

    /// <summary>
    /// Cancels any in-flight render operation and releases component resources.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        _renderCts?.Cancel();
        _renderCts?.Dispose();

        if (_jsModule is not null)
        {
            await _jsModule.DisposeAsync();
        }
    }

}