@model KineticReports.Viewer.Mvc.KineticReportViewModel

<div id="@Model.ViewerId" class="@Model.ViewerCssClass" style="@Model.ViewerStyle" data-page-count="@Model.PageCount">
    <div class="kinetic-report-card">
        <div class="kinetic-report-card-header" role="toolbar" aria-label="Report actions">
            <div class="kinetic-report-toolbar-group">
                <button type="button" class="kinetic-report-header-button"
                        disabled="@string.IsNullOrEmpty(Model.HtmlContent)" title="Print report" aria-label="Print report">
                    <i class="fa-solid fa-print"></i>
                </button>
            </div>

            <div class="kinetic-report-viewer-pager" aria-label="Report page navigation">
                <button type="button" class="kinetic-report-header-button" data-action="first" title="First page"
                        aria-label="First page"><i class="fa-solid fa-backward-fast"></i></button>
                <button type="button" class="kinetic-report-header-button" data-action="prev" title="Previous page"
                        aria-label="Previous page"> <i class="fa-solid fa-backward-step"></i></button>
                <span data-role="page-indicator">Page 1 of @Math.Max(Model.PageCount, 1)</span>
                <button type="button" class="kinetic-report-header-button" data-action="next" title="Next page"
                        aria-label="Next page"><i class="fa-solid fa-forward-step"></i></button>
                <button type="button" class="kinetic-report-header-button" data-action="last" title="Last page"
                        aria-label="Last page"><i class="fa-solid fa-forward-fast"></i></button>
            </div>

            <div class="kinetic-report-toolbar-group">
                <button type="button" class="kinetic-report-header-button" disabled="@(Model.ReportDocument is null)"
                        title="Download PDF" aria-label="Download PDF">
                    <i class="fa-solid fa-file-pdf"></i>
                </button>
                <button type="button" class="kinetic-report-header-button" disabled="@(Model.ReportDocument is null)"
                        title="Download HTML" aria-label="Download HTML">
                    <i class="fa-brands fa-html5"></i>
                </button>

            </div>
        </div>

        
        <div class="kinetic-report-card-body">
            @if (!string.IsNullOrWhiteSpace(GetInlinePreviewMarkup()))
            {
                <div class="report-output">
                    <div class="preview-content" data-role="preview-content">@Html.Raw(GetInlinePreviewMarkup())</div>
                </div>
            }
            else
            {
                <div class="alert alert-info">Provide a report document to render preview output.</div>
            }
        </div>
    </div>

</div>

@functions {
    string GetInlinePreviewMarkup()
    {
        if (Model.ReportDocument is null)
        {
            return string.Empty;
        }
        return string.Empty;
    }
}
<script>
    @* (function () {
        var viewerId = "@Model.ViewerId";
        var initialize = function () {
        if (window.kineticReportsMvcViewer && typeof window.kineticReportsMvcViewer.initialize === "function") {
        window.kineticReportsMvcViewer.initialize(viewerId);
        }
        };

        if (document.readyState === "complete") {
        initialize();
        return;
        }

        window.addEventListener("load", initialize, { once: true });
    })(); *@
</script>
