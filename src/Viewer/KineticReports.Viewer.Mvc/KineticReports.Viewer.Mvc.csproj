<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PackageId>KineticReports.Viewer.Mvc</PackageId>
    <Version>1.0.0</Version>
    <PackageVersion>1.0.0</PackageVersion>
    <Title>KineticReports Viewer for MVC</Title>
    <Description>ASP.NET Core MVC viewer package for hosting KineticReports previews and exports in MVC applications.</Description>
    <Authors>Mike Eckel</Authors>
    <Company>KineticReports</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/michaeleckel/kinetic-reports</RepositoryUrl>
    <PackageProjectUrl>https://github.com/michaeleckel/kinetic-reports</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>1.0.0: Initial Core-centric package layout with ASP.NET Core MVC viewer support.</PackageReleaseNotes>
    <PackageTags>reporting;aspnetcore;mvc;viewer</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\KineticReports.Core\KineticReports.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
