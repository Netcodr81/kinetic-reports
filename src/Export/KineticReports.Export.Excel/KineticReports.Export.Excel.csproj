<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>KineticReports.Export.Excel</PackageId>
    <Version>1.0.0</Version>
    <PackageVersion>1.0.0</PackageVersion>
    <Title>KineticReports Excel Export Example</Title>
    <Description>Example Excel exporter package for KineticReports. Core built-in exporters are HTML and PDF. This is an example implementation demonstrating the exporter extension pattern.</Description>
    <Authors>Mike Eckel</Authors>
    <Company>KineticReports</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/michaeleckel/kinetic-reports</RepositoryUrl>
    <PackageProjectUrl>https://github.com/michaeleckel/kinetic-reports</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>1.0.0: Example Excel exporter package aligned to the consolidated KineticReports.Core runtime.</PackageReleaseNotes>
    <PackageTags>reporting;excel;xlsx;example</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
