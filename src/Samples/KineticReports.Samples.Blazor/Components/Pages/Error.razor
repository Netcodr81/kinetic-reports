@page "/error"
@using System.Diagnostics
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Error</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="alert alert-danger">
                <h1 class="alert-heading">Error!</h1>
                <p>An unexpected error occurred. Please try again later.</p>
            </div>

            @if (ShowDetails)
            {
                <div class="card">
                    <div class="card-header bg-danger text-white">
                        Error Details
                    </div>
                    <div class="card-body">
                        <pre>@ErrorDetails</pre>
                    </div>
                </div>
            }

            <div class="mt-3">
                <a href="/" class="btn btn-primary">Return to Home</a>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public ErrorBoundary? ErrorBoundary { get; set; }

    private bool ShowDetails => !IsProd;
    private string? ErrorDetails { get; set; }
    private bool IsProd => Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Production";

    protected override void OnInitialized()
    {
        ErrorBoundary?.Recover();
    }
}
