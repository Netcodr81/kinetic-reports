@page "/"
@using KineticReports.Core.Engine
@using KineticReports.Core.Layout
@using KineticReports.Core.Viewer.Services
@using KineticReports.Samples.Blazor.Services
@using KineticReports.Viewer.Blazor

@using Microsoft.AspNetCore.Components.Web
@inject ISampleReportCatalogService ReportCatalogService
@inject IReportEngine ReportEngine
@inject IReportService ViewerReportService
@inject IJSRuntime Js
@rendermode InteractiveServer


<PageTitle>KineticReports Realistic Sample</PageTitle>

<div class="row">
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Report Inputs</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Report Template</label>
                    <select class="form-select form-select-sm" value="@_selectedTemplateId"
                            @onchange="OnTemplateChanged">
                        @foreach (var template in _templates)
                        {
                            <option value="@template.Id">@template.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Data Provider</label>
                    <select class="form-select form-select-sm" value="@_selectedProviderType"
                            @onchange="OnProviderChanged">
                        @foreach (var provider in _providers)
                        {
                            <option value="@provider.ProviderType">@provider.DisplayName</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Display Options</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="include-header"
                               checked="@_includePageHeader"
                               @onchange="OnIncludeHeaderChanged" />
                        <label class="form-check-label small" for="include-header">Include page header</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="include-footer"
                               checked="@_includePageFooter"
                               @onchange="OnIncludeFooterChanged" />
                        <label class="form-check-label small" for="include-footer">Include page footer</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="include-page-numbers"
                               checked="@_includePageNumbers"
                               @onchange="OnIncludePageNumbersChanged"
                               disabled="@(!_includePageFooter)" />
                        <label class="form-check-label small" for="include-page-numbers">Include page numbers</label>
                    </div>
                </div>

                <div class="d-grid gap-2 mb-3">
                    <button class="btn btn-primary btn-sm" @onclick="LoadSelectedReportAsync" disabled="@_isBusy">
                        @if (_isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Load Report
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="DownloadJsonAsync"
                            disabled="@(_isBusy || string.IsNullOrWhiteSpace(_definitionJson))">
                        Download Effective JSON
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ExportHtmlAsync"
                            disabled="@(_isBusy || _activeDefinition is null || _activeReportDocument is null)">
                        Export HTML
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ExportPdfAsync"
                            disabled="@(_isBusy || _activeDefinition is null || _activeReportDocument is null)">
                        Export PDF
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(_selectedTemplateDescription))
                {
                    <p class="small text-muted mb-0">@_selectedTemplateDescription</p>
                }
            </div>
        </div>

        <div class="alert alert-secondary small mt-3 mb-0">
            <div><strong>SQLite provider setup:</strong></div>
            <div>Connection string key: ConnectionStrings:SqlLite</div>
            <div>The sample auto-seeds a local database at startup using Data/sample-reports-sqlite.seed.sql.</div>
            <div>It creates the reporting tables used by both sample reports.</div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Report Preview</h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(_status))
                {
                    <div class="alert alert-info py-2 mb-3">@_status</div>
                }

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="alert alert-danger py-2 mb-3">@_error</div>
                }

                <div class="row">
                    <div class="col-lg-5 mb-3">
                        <div class="card h-100">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">Effective ReportDefinition JSON</h6>
                                @if (!string.IsNullOrWhiteSpace(_activeReportName))
                                {
                                    <span class="small text-muted">@_activeReportName</span>
                                }
                            </div>
                            <div class="card-body">
                                @if (string.IsNullOrWhiteSpace(_definitionJson))
                                {
                                    <p class="text-muted mb-0">Select a template/provider, then click Load Report.</p>
                                }
                                else
                                {
                                    <pre class="json-preview mb-0">@_definitionJson</pre>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-7 mb-3">
                        <div class="card h-100">
                            <div class="card-header">
                                <h6 class="mb-0">Viewer</h6>
                            </div>
                            <div class="card-body">
                                @if (_activeDefinition is null)
                                {
                                    <p class="text-muted mb-0">Load a report to preview the rendered output.</p>
                                }
                                else
                                {
                                    <ReportViewer Definition="@_activeDefinition" ReportDocument="@_activeReportDocument" Parameters="@_viewerParameters"
                                                  AutoExecute="true" OnExecutionComplete="OnViewerExecutionComplete"
                                                  OnSearchComplete="OnViewerSearchComplete"
                                                  OnHitTestComplete="OnViewerHitTestComplete" />
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly IReadOnlySet<string> LayoutItemTypes = new HashSet<string>(StringComparer.Ordinal)
    {
        nameof(ReportLayoutItemKind.Text),
        nameof(ReportLayoutItemKind.Table),
        nameof(ReportLayoutItemKind.PageBreak)
    };

    private bool _isBusy;
    private string? _activeReportName;
    private string? _definitionJson;
    private string? _error;
    private string? _status;
    private ReportDefinition? _activeDefinition;
    private ReportDocument? _activeReportDocument;
    private IReadOnlyDictionary<string, object?> _viewerParameters = new Dictionary<string, object?>();
    private IReadOnlyList<SampleReportTemplateDescriptor> _templates = [];
    private IReadOnlyList<ProviderOption> _providers =
    [
        new ProviderOption("InMemory", "In-Memory (Poco provider)"),
        new ProviderOption("SqlLite", "SQLite")
    ];

    private string _selectedTemplateId = string.Empty;
    private string _selectedProviderType = string.Empty;
    private bool _includePageHeader = true;
    private bool _includePageFooter = true;
    private bool _includePageNumbers = true;

    private string? _selectedTemplateDescription => _templates
        .FirstOrDefault(template => string.Equals(template.Id, _selectedTemplateId, StringComparison.Ordinal))
        ?.Description;

    protected override async Task OnInitializedAsync()
    {
        _templates = ReportCatalogService.GetTemplates();
        _selectedTemplateId = _templates.FirstOrDefault()?.Id ?? string.Empty;
        _selectedProviderType = _providers.FirstOrDefault()?.ProviderType ?? string.Empty;

        await LoadSelectedReportAsync();
    }

    private async Task LoadSelectedReportAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedTemplateId) || string.IsNullOrWhiteSpace(_selectedProviderType))
        {
            _error = "Select a report template and provider.";
            return;
        }

        _isBusy = true;
        _error = null;

        try
        {
            var loadedDefinition = await ReportCatalogService.LoadAsync(_selectedTemplateId, _selectedProviderType);
            _activeDefinition = ApplyLayoutDisplayOptions(loadedDefinition);
            _definitionJson = BuildDisplayDefinitionJson(_activeDefinition);
            _activeReportName = _activeDefinition.Name;
            _viewerParameters = BuildDefaultParameters(_activeDefinition);
            _activeReportDocument = await ReportEngine.RunAsync(_activeDefinition);
            _status = $"Loaded '{_activeDefinition.Name}' using provider '{_selectedProviderType}' and built {_activeReportDocument.PageCount} page(s).";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _activeDefinition = null;
            _activeReportDocument = null;
            _definitionJson = null;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OnProviderChanged(ChangeEventArgs args)
    {
        _selectedProviderType = Convert.ToString(args.Value) ?? string.Empty;
        ResetTransientStatus();
    }

    private void OnTemplateChanged(ChangeEventArgs args)
    {
        _selectedTemplateId = Convert.ToString(args.Value) ?? string.Empty;
        ResetTransientStatus();
    }

    private void OnIncludeHeaderChanged(ChangeEventArgs args)
    {
        _includePageHeader = args.Value is bool b && b;
        ResetTransientStatus();
    }

    private void OnIncludeFooterChanged(ChangeEventArgs args)
    {
        _includePageFooter = args.Value is bool b && b;
        if (!_includePageFooter)
            _includePageNumbers = false;
        ResetTransientStatus();
    }

    private void OnIncludePageNumbersChanged(ChangeEventArgs args)
    {
        _includePageNumbers = args.Value is bool b && b;
        ResetTransientStatus();
    }

    private void OnViewerExecutionComplete(ReportExecutionResult result)
    {
        if (!result.Success)
        {
            _error = result.ErrorMessage;
            return;
        }

        _status = $"Viewer refreshed at {result.ExecutedAt:HH:mm:ss} UTC.";
    }

    private void OnViewerSearchComplete(ReportViewerTextSearchResult result)
    {
        _status =
            result.Matches.Count == 0
                ? $"Search '{result.Query}': no matches."
                : $"Search '{result.Query}': {result.Matches.Count} match(es).";
    }

    private void OnViewerHitTestComplete(ReportViewerHitTestResult result)
    {
        _status = result.Hit
            ? $"Hit-test: page {result.PageNumber}, element {result.ElementId ?? "(unknown)"}."
            : $"Hit-test: no element at ({result.X}, {result.Y}) on page {result.PageNumber}.";
    }

    private async Task DownloadJsonAsync()
    {
        if (string.IsNullOrWhiteSpace(_definitionJson))
            return;

        var fileName = string.IsNullOrWhiteSpace(_activeReportName)
            ? "report-definition.json"
            : $"{_activeReportName.Replace(' ', '-')}.json";
        var payload = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(_definitionJson));

        await Js.InvokeVoidAsync(
            "kineticReports.downloadFromBase64",
            fileName,
            "application/json",
            payload);

        _status = $"Downloaded {fileName}.";
    }

    private Task ExportHtmlAsync() => ExportCurrentReportAsync("html");

    private Task ExportPdfAsync() => ExportCurrentReportAsync("pdf");

    private async Task ExportCurrentReportAsync(string formatId)
    {
        if (_activeDefinition is null || _activeReportDocument is null)
        {
            _error = "Load a report before exporting.";
            return;
        }

        _isBusy = true;
        _error = null;

        try
        {
            var exportResult = await ViewerReportService
                .ExportAsync(_activeReportDocument, formatId)
                .ConfigureAwait(false);

            var fileBaseName = string.IsNullOrWhiteSpace(_activeDefinition.Name)
                ? "report"
                : string.Concat(_activeDefinition.Name.Select(ch => Path.GetInvalidFileNameChars().Contains(ch) ? '-' : ch));

            var fileName = $"{fileBaseName}.{exportResult.FileExtension}";
            var payload = Convert.ToBase64String(exportResult.Content);

            await Js.InvokeVoidAsync(
                "kineticReports.downloadFromBase64",
                fileName,
                exportResult.MimeType,
                payload);

            _status = $"Exported {fileName}.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static IReadOnlyDictionary<string, object?> BuildDefaultParameters(ReportDefinition definition)
    {
        var values = new Dictionary<string, object?>(StringComparer.Ordinal);

        foreach (var parameter in definition.Parameters)
        {
            values[parameter.Id] = parameter.Type == ParameterType.Boolean
                ? bool.TryParse(parameter.DefaultValue, out var parsed) && parsed
                : parameter.DefaultValue;
        }

        return values;
    }

    private ReportDefinition ApplyLayoutDisplayOptions(ReportDefinition definition)
    {
        if (definition.Layout is null)
            return definition;

        var header = _includePageHeader
            ? definition.Layout.PageHeader.ToList()
            : [];

        var footer = _includePageFooter
            ? definition.Layout.PageFooter.ToList()
            : [];

        if (_includePageFooter)
        {
            if (!_includePageNumbers)
            {
                footer = footer
                    .Where(item => !IsPageNumberFooterItem(item))
                    .ToList();
            }
            else if (!footer.Any(IsPageNumberFooterItem))
            {
                footer.Add(new ReportLayoutItemDefinition
                {
                    Id = "runtime-page-number",
                    Kind = ReportLayoutItemKind.Text,
                    Text = "Page {PageNumber}"
                });
            }
        }

        return definition with
        {
            Layout = definition.Layout with
            {
                PageHeader = header,
                PageFooter = footer
            }
        };
    }

    private static bool IsPageNumberFooterItem(ReportLayoutItemDefinition item)
    {
        if (item.Kind != ReportLayoutItemKind.Text)
            return false;

        return !string.IsNullOrWhiteSpace(item.Text)
            && item.Text.Contains("{PageNumber}", StringComparison.OrdinalIgnoreCase);
    }

    private void ResetTransientStatus()
    {
        _status = null;
        _error = null;
    }

    private static string BuildDisplayDefinitionJson(ReportDefinition definition)
    {
        var options = new System.Text.Json.JsonSerializerOptions
        {
            WriteIndented = true,
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
        };
        options.Converters.Add(new System.Text.Json.Serialization.JsonStringEnumConverter());

        var node = System.Text.Json.JsonSerializer.SerializeToNode(definition, options)
            ?? throw new InvalidOperationException("Failed to build JSON preview for the active report definition.");

        RenameLayoutItemKindToType(node);

        return node.ToJsonString(options);
    }

    private static void RenameLayoutItemKindToType(System.Text.Json.Nodes.JsonNode node)
    {
        if (node is System.Text.Json.Nodes.JsonObject obj)
        {
            if (obj.TryGetPropertyValue("kind", out var kindNode)
                && kindNode is System.Text.Json.Nodes.JsonValue kindValue
                && kindValue.TryGetValue<string>(out var kindText)
                && LayoutItemTypes.Contains(kindText))
            {
                obj.Remove("kind");
                obj["type"] = kindText;
            }

            foreach (var child in obj.ToList())
            {
                if (child.Value is not null)
                    RenameLayoutItemKindToType(child.Value);
            }
        }
        else if (node is System.Text.Json.Nodes.JsonArray arr)
        {
            foreach (var child in arr)
            {
                if (child is not null)
                    RenameLayoutItemKindToType(child);
            }
        }
    }

    private sealed record ProviderOption(string ProviderType, string DisplayName);
}

<style>
    .json-preview {
        max-height: 980px;
        overflow: auto;
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        padding: 0.75rem;
        font-size: 0.8rem;
    }
</style>
