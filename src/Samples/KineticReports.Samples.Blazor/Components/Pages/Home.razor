@page "/"
@using KineticReports.Authoring.Components
@using KineticReports.Samples.Blazor.Services
@using KineticReports.Viewer.Blazor
@using KineticReports.Viewer.Blazor.Services

@using Microsoft.AspNetCore.Components.Web
@inject IPluginService PluginService
@inject IAuthoringJsonWorkflowService AuthoringWorkflowService
@inject IAuthoredReportCatalogService ReportCatalogService
@inject IJSRuntime Js
@rendermode InteractiveServer


<PageTitle>KineticReports Samples</PageTitle>

<div class="row">
    <div class="col-lg-3">
        <div class="card mb-3">
            <div class="card-header">
                <h5>Plugin Management</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <button class="btn btn-primary w-100" @onclick="LoadPluginsAsync">
                        @if (_isLoadingPlugins)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Loading...</span>
                        }
                        else
                        {
                            <span>Load Plugins</span>
                        }
                    </button>
                </div>

                <div class="mb-3">
                    <button class="btn btn-danger w-100" @onclick="UnloadPluginsAsync"
                            disabled="@(PluginService.LoadedPlugins.Count == 0)">
                        Unload All Plugins
                    </button>
                </div>

                <hr />

                <h6>Loaded Plugins:</h6>
                @if (PluginService.LoadedPlugins.Count == 0)
                {
                    <p class="text-muted small">No plugins loaded</p>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var plugin in PluginService.LoadedPlugins)
                        {
                            <div class="list-group-item">
                                <h6 class="mb-1">@plugin.Name</h6>
                                <small class="text-muted">v@plugin.Version</small>
                                @if (!string.IsNullOrEmpty(plugin.Author))
                                {
                                    <div class="small">by @plugin.Author</div>
                                }
                                @if (!string.IsNullOrEmpty(plugin.Description))
                                {
                                    <div class="small mt-1">@plugin.Description</div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Report Catalog</h6>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label small">Saved reports</label>
                    <select class="form-select form-select-sm" value="@_selectedCatalogItemId"
                            @onchange="OnCatalogSelectionChanged">
                        <option value="">(none)</option>
                        @foreach (var item in _catalogItems)
                        {
                            <option value="@item.Id">@item.Name (@item.ProviderType)</option>
                        }
                    </select>
                </div>

                <div class="d-grid gap-2">
                    <button class="btn btn-outline-primary btn-sm" @onclick="LoadCatalogEntryAsync"
                            disabled="@(_isBusy || string.IsNullOrWhiteSpace(_selectedCatalogItemId))">
                        Load Saved Report
                    </button>
                    <button class="btn btn-outline-danger btn-sm" @onclick="DeleteCatalogEntryAsync"
                            disabled="@(_isBusy || string.IsNullOrWhiteSpace(_selectedCatalogItemId))">
                        Delete Saved Report
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-9">
        <div class="card">
            <div class="card-header">
                <h5>Report Workbench</h5>
            </div>
            <div class="card-body">
                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Report Type</label>
                        <select class="form-select form-select-sm" value="@_selectedComponentType"
                                @onchange="OnComponentTypeChanged" disabled="@_isBusy">
                            @foreach (var componentType in _componentTypes)
                            {
                                <option value="@componentType">@componentType</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Data Source Type</label>
                        <select class="form-select form-select-sm" value="@_selectedProviderType"
                                @onchange="OnProviderTypeChanged" disabled="@_isBusy">
                            @foreach (var provider in _providerOptions)
                            {
                                <option value="@provider.ProviderType">@provider.DisplayName</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Catalog Name</label>
                        <input type="text" class="form-control form-control-sm" value="@_catalogName"
                               @onchange="OnCatalogNameChanged" placeholder="Report name for save" />
                    </div>
                </div>

                <div class="d-flex align-items-end gap-2 flex-wrap mb-3">
                    <button class="btn btn-primary btn-sm" @onclick="GenerateDefinitionAsync" disabled="@_isBusy">
                        @if (_isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Author + Compile
                    </button>

                    <button class="btn btn-outline-success btn-sm" @onclick="SaveCurrentReportAsync"
                            disabled="@(_isBusy || _compiledDefinition is null || string.IsNullOrWhiteSpace(_json))">
                        Save To Catalog
                    </button>

                    <button class="btn btn-outline-secondary btn-sm" @onclick="DownloadJsonAsync"
                            disabled="@(_isBusy || string.IsNullOrWhiteSpace(_json))">
                        Download JSON
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(_status))
                {
                    <div class="alert alert-info py-2 mb-3">@_status</div>
                }

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="alert alert-danger py-2 mb-3">@_error</div>
                }

                <div class="row">
                    <div class="col-lg-5 mb-3">
                        <div class="card h-100">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">Generated JSON</h6>
                                @if (!string.IsNullOrWhiteSpace(_selectedReportName))
                                {
                                    <span class="small text-muted">@_selectedReportName</span>
                                }
                            </div>
                            <div class="card-body">
                                @if (string.IsNullOrWhiteSpace(_json))
                                {
                                    <p class="text-muted mb-0">Click Author + Compile to produce JSON.</p>
                                }
                                else
                                {
                                    <pre class="json-preview mb-0">@_json</pre>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-7 mb-3">
                        <div class="card h-100">
                            <div class="card-header">
                                <h6 class="mb-0">Viewer</h6>
                            </div>
                            <div class="card-body">
                                @if (_compiledDefinition is null)
                                {
                                    <p class="text-muted mb-0">Create or load a report from catalog to view and export.</p>
                                }
                                else
                                {
                                    <ReportViewer Definition="@_compiledDefinition" Parameters="@_viewerParameters"
                                                  AutoExecute="true" OnExecutionComplete="OnViewerExecutionComplete"
                                                  OnSearchComplete="OnViewerSearchComplete"
                                                  OnHitTestComplete="OnViewerHitTestComplete" />
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private const string MultiPageAllBlocksOption = "AllBlockTypesMultiPage";
    private const string MultiPageAllBlocksSampleId = "all-components-multipage";

    private bool _isLoadingPlugins;
    private bool _isBusy;
    private string? _selectedReportName;
    private string? _json;
    private string? _error;
    private string? _status;
    private ReportDefinition? _compiledDefinition;
    private IReadOnlyList<AuthoringDataProviderDescriptor> _providerOptions = [];
    private IReadOnlyList<string> _componentTypes = [];
    private IReadOnlyDictionary<string, object?> _viewerParameters = new Dictionary<string, object?>();
    private IReadOnlyList<AuthoredReportCatalogItem> _catalogItems = [];
    private string _selectedComponentType = string.Empty;
    private string _selectedProviderType = string.Empty;
    private string _selectedCatalogItemId = string.Empty;
    private string _catalogName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _providerOptions = AuthoringWorkflowService.GetProviderOptions();
        _selectedProviderType = _providerOptions.FirstOrDefault()?.ProviderType ?? string.Empty;

        _componentTypes = Enum.GetValues<ReportComponentType>()
            .Select(type => type.ToString())
            .OrderBy(name => name, StringComparer.Ordinal)
            .ToList();

        _componentTypes = [MultiPageAllBlocksOption, .. _componentTypes];
        _selectedComponentType = _componentTypes.FirstOrDefault() ?? string.Empty;

        await RefreshCatalogAsync();
    }

    private async Task LoadPluginsAsync()
    {
        _isLoadingPlugins = true;
        try
        {
            await PluginService.InitializePluginAsync();
            _status = "Plugins loaded.";
        }
        finally
        {
            _isLoadingPlugins = false;
        }
    }

    private async Task UnloadPluginsAsync()
    {
        await PluginService.UnloadAllAsync();
        _status = "Plugins unloaded.";
    }

    private async Task GenerateDefinitionAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedComponentType) || string.IsNullOrWhiteSpace(_selectedProviderType))
        {
            _error = "Select a report type and provider before authoring.";
            return;
        }

        _isBusy = true;
        _error = null;

        try
        {
            var sampleId = ResolveSampleId(_selectedComponentType);
            _json = AuthoringWorkflowService.GenerateSampleJson(sampleId, _selectedProviderType);
            _compiledDefinition = AuthoringWorkflowService.CompileFromJson(_json);
            _selectedReportName = _compiledDefinition.Name;
            _catalogName = _selectedReportName ?? string.Empty;
            _viewerParameters = BuildDefaultParameters(_compiledDefinition);
            _status = $"Compiled '{_compiledDefinition.Name}' from authored JSON.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SaveCurrentReportAsync()
    {
        if (_compiledDefinition is null || string.IsNullOrWhiteSpace(_json))
            return;

        _isBusy = true;
        _error = null;

        try
        {
            var reportName = string.IsNullOrWhiteSpace(_catalogName)
                ? _compiledDefinition.Name
                : _catalogName.Trim();

            var sampleId = ResolveSampleId(_selectedComponentType);
            var saved = await ReportCatalogService.SaveAsync(
                string.IsNullOrWhiteSpace(_selectedCatalogItemId) ? null : _selectedCatalogItemId,
                reportName,
                sampleId,
                _selectedProviderType,
                _json);

            _selectedCatalogItemId = saved.Item.Id;
            _catalogName = saved.Item.Name;
            _status = $"Saved '{saved.Item.Name}' to catalog.";
            await RefreshCatalogAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task LoadCatalogEntryAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedCatalogItemId))
            return;

        _isBusy = true;
        _error = null;

        try
        {
            var entry = await ReportCatalogService.GetAsync(_selectedCatalogItemId);
            if (entry is null)
            {
                _error = "Selected catalog report could not be found.";
                return;
            }

            _json = entry.Json;
            _compiledDefinition = AuthoringWorkflowService.CompileFromJson(_json);
            _selectedReportName = _compiledDefinition.Name;
            _selectedProviderType = entry.Item.ProviderType;
            _catalogName = entry.Item.Name;
            _viewerParameters = BuildDefaultParameters(_compiledDefinition);
            _status = $"Loaded '{entry.Item.Name}' from catalog.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteCatalogEntryAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedCatalogItemId))
            return;

        _isBusy = true;
        _error = null;

        try
        {
            var deleted = await ReportCatalogService.DeleteAsync(_selectedCatalogItemId);
            if (!deleted)
            {
                _error = "Report was not found in catalog.";
                return;
            }

            _selectedCatalogItemId = string.Empty;
            _status = "Deleted report from catalog.";
            await RefreshCatalogAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RefreshCatalogAsync()
    {
        _catalogItems = await ReportCatalogService.ListAsync();
    }

    private void OnComponentTypeChanged(ChangeEventArgs args)
    {
        _selectedComponentType = Convert.ToString(args.Value) ?? string.Empty;
        ResetTransientStatus();
    }

    private void OnProviderTypeChanged(ChangeEventArgs args)
    {
        _selectedProviderType = Convert.ToString(args.Value) ?? string.Empty;
        ResetTransientStatus();
    }

    private void OnCatalogNameChanged(ChangeEventArgs args)
    {
        _catalogName = Convert.ToString(args.Value) ?? string.Empty;
    }

    private void OnCatalogSelectionChanged(ChangeEventArgs args)
    {
        _selectedCatalogItemId = Convert.ToString(args.Value) ?? string.Empty;
        ResetTransientStatus();
    }

    private void OnViewerExecutionComplete(ReportExecutionResult result)
    {
        if (!result.Success)
        {
            _error = result.ErrorMessage;
            return;
        }

        _status = $"Viewer refreshed at {result.ExecutedAt:HH:mm:ss} UTC.";
    }

    private void OnViewerSearchComplete(ReportViewerTextSearchResult result)
    {
        _status =
            result.Matches.Count == 0
                ? $"Search '{result.Query}': no matches."
                : $"Search '{result.Query}': {result.Matches.Count} match(es).";
    }

    private void OnViewerHitTestComplete(ReportViewerHitTestResult result)
    {
        _status = result.Hit
            ? $"Hit-test: page {result.PageNumber}, element {result.ElementId ?? "(unknown)"}."
            : $"Hit-test: no element at ({result.X}, {result.Y}) on page {result.PageNumber}.";
    }

    private async Task DownloadJsonAsync()
    {
        if (string.IsNullOrWhiteSpace(_json))
            return;

        var fileName = string.IsNullOrWhiteSpace(_selectedReportName)
            ? "authored-report.json"
            : $"{_selectedReportName.Replace(' ', '-')}.json";
        var payload = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(_json));

        await Js.InvokeVoidAsync(
            "kineticReports.downloadFromBase64",
            fileName,
            "application/json",
            payload);

        _status = $"Downloaded {fileName}.";
    }

    private static IReadOnlyDictionary<string, object?> BuildDefaultParameters(ReportDefinition definition)
    {
        var values = new Dictionary<string, object?>(StringComparer.Ordinal);

        foreach (var parameter in definition.Parameters)
        {
            values[parameter.Id] = parameter.Type == ParameterType.Boolean
                ? bool.TryParse(parameter.DefaultValue, out var parsed) && parsed
                : parameter.DefaultValue;
        }

        return values;
    }

    private void ResetTransientStatus()
    {
        _status = null;
        _error = null;
    }

    private static string ResolveSampleId(string selectedType)
    {
        if (string.Equals(selectedType, MultiPageAllBlocksOption, StringComparison.OrdinalIgnoreCase))
            return MultiPageAllBlocksSampleId;

        return $"component-{selectedType.ToLowerInvariant()}";
    }
}

<style>
    .json-preview {
        max-height: 980px;
        overflow: auto;
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        padding: 0.75rem;
        font-size: 0.8rem;
    }
</style>
