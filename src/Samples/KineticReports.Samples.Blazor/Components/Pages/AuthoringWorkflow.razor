@page "/authoring-workflow"
@rendermode InteractiveServer

<PageTitle>KineticReports Sample Notes</PageTitle>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Sample Setup Notes</h5>
    </div>
    <div class="card-body">
        <p class="mb-2">
            This sample app now mirrors a typical runtime integration flow:
        </p>
        <ul>
            <li>Load report definitions from JSON files.</li>
            <li>Load report definitions built in code.</li>
            <li>Switch between In-Memory (POCO) and SQLite providers.</li>
            <li>Render through the same engine and viewer pipeline.</li>
        </ul>

        <p class="mb-0">
            Use the Reports page to run the end-to-end examples.
        </p>
    </div>
</div>
