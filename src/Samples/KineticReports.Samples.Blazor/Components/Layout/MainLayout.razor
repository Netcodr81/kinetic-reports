@inherits LayoutComponentBase

<div class="page">
    <header class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="">KineticReports Samples</a>
            <div class="navbar-nav ms-3">
                <NavLink href="/" class="nav-link" Match="NavLinkMatch.All">Reports</NavLink>
            </div>
            <div class="navbar-nav ms-auto">
                <span class="nav-link">Blazor Viewer + JSON + Builder</span>
            </div>
        </div>
    </header>

    <div class="container-fluid mt-4">
        @Body
    </div>

    <footer class="footer mt-5 py-3 bg-light border-top">
        <div class="container text-center">
            <span class="text-muted">KineticReports © 2026 - Interactive Report Viewer Sample</span>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f5f5f5;
    }

    .page {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .container-fluid {
        flex: 1;
    }

    .navbar {
        box-shadow: 0 2px 4px rgba(0, 0, 0, .1);
    }

    .navbar-brand {
        font-weight: 600;
        font-size: 1.25rem;
    }

    .footer {
        margin-top: auto;
        border-top: 1px solid #dee2e6;
    }

    .card {
        border: none;
        box-shadow: 0 2px 8px rgba(0, 0, 0, .1);
        margin-bottom: 1rem;
    }

    .card-header {
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        font-weight: 600;
    }
</style>
