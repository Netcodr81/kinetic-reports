@using System.Reflection
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web

<Router AppAssembly="@typeof(Program).Assembly" AdditionalAssemblies="@_additionalAssemblies">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Components.Layout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(Components.Layout)">
            <div class="alert alert-danger">
                <h1>404 - Not Found</h1>
                <p>Sorry, the page you requested does not exist.</p>
            </div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private static readonly Assembly[] _additionalAssemblies = [];
}

